---
/**
 * /willkommen — öffentliche Marketing-Landingpage (B2B-first, immersiver Stil).
 * On-demand, aber ÖFFENTLICH (Middleware-Allowlist). Wird Section für Section
 * aufgebaut/abgestimmt. Palette: Kosmos-Blau (Navy) + Titan-Gold.
 * Hero: Blue-Marble-Erde unten-mittig (Screen-Blend, nahtlos), Nav = Wortmarke +
 * Burger, dessen Overlay sich kreisförmig über den Screen aufbläht.
 * Self-hosted Fonts (Space Grotesk / Inter). GSAP; prefers-reduced-motion.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const NAV = [
  { href: '#fachwirte', label: 'Fachrichtungen' },
  { href: '#angebot', label: 'Angebot' },
  { href: '#vertrauen', label: 'Vertrauen' },
];
---

<BaseLayout
  title="Für Bildungsträger"
  description="Die IHK-Fachwirt-Vorbereitung als interaktives Kompetenz-Erlebnis — für Bildungsträger, die Bestehensquote und Kurs-Qualität steigern."
  canonicalPath="/willkommen/"
  theme="light"
>
  <main id="hauptinhalt" class="lp">
    <!-- ── HERO (Vollbild) ─────────────────────────────── -->
    <section class="lp-hero">
      <div class="lp-bg-wrap" aria-hidden="true">
        <img class="lp-bg" src={`${base}willkommen/hero-earth.jpg`} alt="" width="2560" height="2560" />
      </div>
      <div class="lp-scrim" aria-hidden="true"></div>

      <!-- Hero-Inhalt -->
      <div class="lp-hero-content">
        <div class="lp-hero-text">
          <div class="lp-card-bg" aria-hidden="true"></div>
          <span class="lp-eyebrow" data-drop><i class="lp-dot" aria-hidden="true"></i> Interaktive IHK-Fachwirt-Vorbereitung</span>
          <h1 class="lp-h1" data-anim>Vom Wissen<br />zur <span class="lp-accent">Wirkung.</span></h1>
          <p class="lp-sub" data-anim>Die Learning Experience Platform (LXP), die anspruchsvolle Curricula in exzellente Lernerlebnisse übersetzt – für höchste Kursqualität und maximale Erfolgsquoten.</p>
        </div>
      </div>

      <!-- Aktionen: frei unten rechts (locker, außerhalb des Glases) -->
      <div class="lp-hero-actions" data-anim>
        <a class="lp-cta" href="#kontakt">
          <span>Demo anfragen</span>
          <span class="lp-cta-circle" aria-hidden="true">↗</span>
        </a>
        <a class="lp-ghost" href="#wie">So funktioniert's</a>
      </div>
    </section>

    <!-- Navigation (außerhalb des Hero-Stapelkontexts, damit der Burger als
         X über dem Menü-Overlay sichtbar/klickbar bleibt) -->
    <header class="lp-nav">
      <div class="lp-nav-inner">
        <a class="lp-brand" href={`${base}willkommen/`}>Titan</a>
        <button type="button" class="lp-burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="lp-menu">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <!-- ── Menü-Overlay (kreisförmiges Aufblähen vom Burger) ── -->
    <div class="lp-menu" id="lp-menu" hidden>
      <nav class="lp-menu-nav" aria-label="Menü">
        {NAV.map((n) => <a class="lp-menu-link" href={n.href}>{n.label}</a>)}
        <a class="lp-menu-cta" href="#kontakt">Kontakt aufnehmen <span aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <!-- ── SECTION 1 · So funktioniert's (4-Phasen-Reise) ── -->
    <section class="lp-how" id="wie">
      <div class="lp-container">
        <header class="lp-sec-head" data-reveal>
          <span class="lp-sec-eyebrow"><i class="lp-dot" aria-hidden="true"></i> So funktioniert's</span>
          <h2 class="lp-sec-title">In vier Phasen zur Wirkung</h2>
          <p class="lp-sec-intro">Ein durchgängiger roter Faden statt loser Kapitel — von der ersten Idee bis zur fertigen Prüfungsleistung.</p>
        </header>

        <ol class="lp-steps">
          <li class="lp-step" data-reveal>
            <span class="lp-step-num">01</span>
            <h3 class="lp-step-title">Verstehen</h3>
            <p class="lp-step-text">Anspruchsvolle Fachinhalte als interaktive Erlebnisse begreifen — nicht auswendig lernen, sondern wirklich durchdringen.</p>
            <div class="lp-step-visual" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" width="58" height="58">
                <circle cx="32" cy="19" r="7" stroke="#fff" stroke-width="2"/>
                <circle cx="17" cy="45" r="6" stroke="#fff" stroke-width="2"/>
                <circle cx="47" cy="45" r="6" stroke="#C4A882" stroke-width="2"/>
                <path d="M32 26 L18 39 M32 26 L46 39" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
          </li>
          <li class="lp-step" data-reveal>
            <span class="lp-step-num">02</span>
            <h3 class="lp-step-title">Merken</h3>
            <p class="lp-step-text">Wissen verankern: kompakte Karten und Wiederholung im richtigen Moment sorgen für nachhaltiges Behalten.</p>
            <div class="lp-step-visual" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" width="58" height="58">
                <rect x="14" y="17" width="28" height="20" rx="3" stroke="#fff" stroke-width="2"/>
                <rect x="22" y="27" width="28" height="20" rx="3" stroke="#C4A882" stroke-width="2"/>
              </svg>
            </div>
          </li>
          <li class="lp-step" data-reveal>
            <span class="lp-step-num">03</span>
            <h3 class="lp-step-title">Anwenden</h3>
            <p class="lp-step-text">An einer durchgängigen Fallfirma mit praxisnahen Werkzeugen arbeiten — von der Analyse bis zur begründeten Entscheidung.</p>
            <div class="lp-step-visual" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" width="58" height="58">
                <line x1="14" y1="25" x2="50" y2="25" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                <circle cx="41" cy="25" r="5" fill="#C4A882"/>
                <line x1="14" y1="41" x2="50" y2="41" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                <circle cx="24" cy="41" r="5" fill="#fff"/>
              </svg>
            </div>
          </li>
          <li class="lp-step" data-reveal>
            <span class="lp-step-num">04</span>
            <h3 class="lp-step-title">Prüfen</h3>
            <p class="lp-step-text">Prüfungsnah testen — und ganz nebenbei entsteht ein präsentationsreifes Ergebnis für die mündliche Prüfung.</p>
            <div class="lp-step-visual" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" width="58" height="58">
                <rect x="20" y="13" width="24" height="32" rx="3" stroke="#fff" stroke-width="2"/>
                <path d="M26 39 l5 5 l9 -12" stroke="#C4A882" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- orizon-artiger Cursor (nur Zeiger-Geräte, JS-gesteuert) -->
    <div class="lp-cursor" aria-hidden="true"></div>
  </main>

  <style>
    /* ── Self-hosted Fonts (latin, deckt DE-Umlaute + ß) ── */
    @font-face { font-family: 'Space Grotesk'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/SpaceGrotesk-500.woff2') format('woff2'); }
    @font-face { font-family: 'Space Grotesk'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/SpaceGrotesk-700.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/Inter-400.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/Inter-500.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/Inter-600.woff2') format('woff2'); }

    /* ── Landing-Palette ── */
    .lp {
      --bg: #EFEDE7;
      --ink: #14181F;
      --navy: #1B2A4A;
      --gold: #C4A882;
      --ink-muted: #5A6172;
      --surface: #FFFFFF;
      --line: rgba(20,24,31,0.10);
      --on: #F5F6F8;
      --on-muted: rgba(245,246,248,0.80);
      --on-faint: rgba(245,246,248,0.16);
      --display: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

      background: var(--bg);
      font-family: var(--body);
      color: var(--ink);
    }
    .lp * { box-sizing: border-box; }

    /* ── HERO Grundgerüst (Vollbild) ── */
    .lp-hero {
      position: relative;
      min-height: 100vh; min-height: 100svh;
      overflow: hidden; display: flex; isolation: isolate;
      background: radial-gradient(125% 95% at 50% 122%, #0d1830 0%, #070b16 52%, #05060c 100%);
    }
    /* Erde: unten-mittig aufsteigend; Screen-Blend blendet den schwarzen
       Bildhintergrund aus → nahtlos, keine sichtbaren Bildkanten. */
    .lp-bg-wrap {
      position: absolute; left: 0; right: 0; bottom: 0; z-index: -1;
      display: flex; justify-content: center; will-change: transform;
    }
    .lp-bg {
      width: min(1500px, 165vw); height: auto;
      transform: translateY(62%);
      mix-blend-mode: screen;
      /* Radial-Maske blendet die JPEG-Kanten/Ecken weg → keine Bild-Kante. */
      -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 60%, transparent 71%);
      mask-image: radial-gradient(circle at 50% 50%, #000 60%, transparent 71%);
      -webkit-user-select: none; user-select: none; pointer-events: none;
    }
    .lp-scrim {
      position: absolute; inset: 0; z-index: -1;
      background: linear-gradient(90deg, rgba(5,6,12,0.30) 0%, rgba(5,6,12,0.04) 44%, rgba(5,6,12,0) 62%);
    }

    /* ── NAV (nur Wortmarke + Burger) ── */
    /* z-index über dem Menü-Overlay (30), damit der Burger als klickbares X
       sichtbar bleibt und das Menü schließen kann. */
    .lp-nav { position: absolute; top: 0; left: 0; right: 0; z-index: 50; }
    .lp-nav-inner {
      max-width: 1360px; margin: 0 auto; padding: 26px 32px;
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
    }
    .lp-brand { font-family: var(--display); font-size: 24px; font-weight: 700; letter-spacing: -0.01em; color: var(--on); text-decoration: none; }

    /* Burger */
    .lp-burger {
      position: relative; z-index: 40;
      width: 52px; height: 44px; border-radius: 999px;
      border: 1px solid var(--on-faint); background: rgba(245,246,248,0.04); backdrop-filter: blur(6px);
      display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px;
      cursor: pointer; transition: border-color .2s ease, background .2s ease;
    }
    .lp-burger:hover { border-color: rgba(245,246,248,0.5); background: rgba(245,246,248,0.09); }
    .lp-burger span { display: block; width: 20px; height: 2px; border-radius: 2px; background: var(--on); transition: transform .3s cubic-bezier(0.16,1,0.3,1), opacity .2s ease; }
    .lp-burger[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .lp-burger[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    .lp-burger:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

    /* ── HERO-INHALT ── */
    .lp-hero-content {
      max-width: 1360px; width: 100%; margin: 0 auto;
      padding: 120px 32px; display: flex; align-items: center;
    }
    .lp-hero-text {
      /* Karte umschließt ihren breitesten Inhalt (die Headline), damit das
         Glas den kompletten Text hinterlegt — auf jedem Endgerät. */
      position: relative;
      width: fit-content; max-width: min(100%, 1040px); min-width: 0;
      padding: 46px 46px 46px;
    }
    /* Glas-Hintergrund als EIGENE Ebene: Die Kerbe (Mask) beschneidet nur
       diese Ebene — Badge & Text liegen darüber und werden NICHT abgeschnitten.
       2. Mask-Ebene (Rechteck an Badge-Position) wird ausgeschnitten; --nw/--nh
       per JS gesetzt/animiert → die Oberkante wird beim Auftreffen nach unten
       gedrückt und bleibt so stehen (2,5-px-Naht um die eingetauchte Hälfte). */
    .lp-card-bg {
      position: absolute; inset: 0; z-index: 0;
      background: rgba(8,12,20,0.32);
      -webkit-backdrop-filter: blur(18px) saturate(115%);
      backdrop-filter: blur(18px) saturate(115%);
      border: 1px solid rgba(245,246,248,0.10);
      border-radius: 28px;
      --nx: 40px; --nw: 0px; --nh: 0px;
      /* Kerbe ohne mask-composite: drei Bänder (links / rechts / unten)
         vereinen sich (Standard-Union) zu „alles außer dem Kerben-Rechteck". */
      -webkit-mask-image: linear-gradient(#000,#000), linear-gradient(#000,#000), linear-gradient(#000,#000);
      mask-image: linear-gradient(#000,#000), linear-gradient(#000,#000), linear-gradient(#000,#000);
      -webkit-mask-repeat: no-repeat, no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat, no-repeat;
      -webkit-mask-position: 0 0, calc(var(--nx) + var(--nw)) 0, 0 var(--nh);
      mask-position: 0 0, calc(var(--nx) + var(--nw)) 0, 0 var(--nh);
      -webkit-mask-size: var(--nx) 100%, calc(100% - var(--nx) - var(--nw)) 100%, 100% calc(100% - var(--nh));
      mask-size: var(--nx) 100%, calc(100% - var(--nx) - var(--nw)) 100%, 100% calc(100% - var(--nh));
    }
    .lp-h1, .lp-sub { position: relative; z-index: 1; }

    /* Badge taucht zur Hälfte in die Glaskarte ein (halb überlappend) und
       durchbricht so die obere Kante — wie hineingefallen. */
    .lp-eyebrow {
      position: absolute; top: 0; left: 40px; transform: translateY(-50%); z-index: 2;
      display: inline-flex; align-items: center; gap: 10px;
      font-size: 12.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase;
      color: var(--on);
      border: 1px solid rgba(245,246,248,0.14); border-radius: 999px; padding: 10px 18px 10px 14px;
      background: rgba(12,17,27,0.85); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
      box-shadow: 0 12px 28px -12px rgba(0,0,0,0.7);
      white-space: nowrap;
    }
    .lp-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); animation: lp-pulse 2.8s ease-in-out infinite; }
    @keyframes lp-pulse {
      0%, 100% { box-shadow: 0 0 0 3px rgba(196,168,130,0.26), 0 0 6px 1px rgba(196,168,130,0.35); }
      50%      { box-shadow: 0 0 0 7px rgba(196,168,130,0.04), 0 0 12px 3px rgba(196,168,130,0.15); }
    }

    .lp-h1 {
      font-family: var(--display);
      font-size: clamp(46px, 7vw, 92px); font-weight: 700; line-height: 0.98;
      letter-spacing: -0.03em; color: var(--on); margin: 0 0 24px; text-wrap: balance;
      overflow-wrap: break-word; hyphens: auto;
    }
    .lp-accent { position: relative; white-space: nowrap; }
    .lp-accent::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0.06em; height: 0.09em;
      background: var(--gold); border-radius: 4px;
    }
    .lp-sub { font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; color: var(--on-muted); max-width: 46ch; margin: 0 0 34px; }

    /* Aktionen frei unten rechts im Hero (locker) */
    .lp-hero-actions {
      position: absolute; right: 32px; bottom: 40px; z-index: 5;
      display: flex; align-items: center; gap: 20px; flex-wrap: wrap; justify-content: flex-end;
    }
    .lp-cta {
      display: inline-flex; align-items: center; gap: 14px;
      background: var(--on); color: var(--navy); text-decoration: none;
      font-size: 15px; font-weight: 600; border-radius: 999px; padding: 8px 8px 8px 24px;
      box-shadow: 0 14px 34px -14px rgba(0,0,0,0.6);
      transition: box-shadow .25s ease, background .25s ease;
    }
    .lp-cta:hover { box-shadow: 0 18px 40px -14px rgba(0,0,0,0.75); background: #fff; }
    .lp-cta-circle { width: 38px; height: 38px; border-radius: 50%; background: var(--gold); color: var(--navy); display: inline-flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 700; transition: transform .35s cubic-bezier(0.16,1,0.3,1); }
    .lp-cta:hover .lp-cta-circle { transform: rotate(45deg); }
    .lp-ghost { font-size: 15px; font-weight: 600; color: var(--on); text-decoration: none; border-bottom: 2px solid var(--on-faint); padding-bottom: 3px; text-shadow: 0 1px 14px rgba(0,0,0,0.55); transition: border-color .2s ease; }
    .lp-ghost:hover { border-color: rgba(245,246,248,0.55); }
    .lp-cta:focus-visible, .lp-ghost:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 4px; }

    /* ── MENÜ-OVERLAY (kreisförmiges Aufblähen) ── */
    .lp-menu {
      position: fixed; inset: 0; z-index: 30;
      background: rgba(6,10,18,0.94); backdrop-filter: blur(16px);
      display: flex; align-items: center; justify-content: center;
      clip-path: circle(var(--r, 0px) at var(--cx, 100%) var(--cy, 0px));
    }
    .lp-menu[hidden] { display: none; }
    .lp-menu-nav { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
    .lp-menu-link {
      font-family: var(--display); font-size: clamp(34px, 6vw, 60px); font-weight: 700;
      letter-spacing: -0.02em; color: var(--on); text-decoration: none; line-height: 1.15;
      opacity: 0.9; transition: opacity .2s ease, color .2s ease;
    }
    .lp-menu-link:hover { opacity: 1; color: var(--gold); }
    .lp-menu-cta {
      margin-top: 28px; font-family: var(--body); font-size: 17px; font-weight: 600;
      color: var(--navy); background: var(--on); text-decoration: none;
      border-radius: 999px; padding: 14px 30px; transition: background .2s ease;
    }
    .lp-menu-cta:hover { background: var(--gold); }
    .lp-menu a:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; border-radius: 6px; }

    /* ── CURSOR (orizon-artig) ── */
    .lp-cursor {
      position: fixed; top: 0; left: 0; width: 12px; height: 12px; border-radius: 50%;
      background: #fff; mix-blend-mode: difference; pointer-events: none; z-index: 60;
      transform: translate(-50%, -50%); opacity: 0;
      transition: width .25s ease, height .25s ease, background .25s ease, opacity .25s ease;
    }
    .lp-cursor.is-active { opacity: 1; }
    .lp-cursor.is-hover { width: 46px; height: 46px; background: rgba(255,255,255,0.85); }

    /* ── LAYOUT-CONTAINER ── */
    .lp-container { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 32px; }

    /* ── SECTION 1 · So funktioniert's (heller Grund, „Licht geht an") ── */
    .lp-how { position: relative; background: var(--bg); color: var(--ink); padding: clamp(84px, 10vw, 148px) 0; }
    .lp-sec-head { max-width: 640px; }
    .lp-sec-eyebrow {
      display: inline-flex; align-items: center; gap: 9px;
      font-size: 12.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--navy); margin-bottom: 18px;
    }
    .lp-sec-eyebrow .lp-dot { animation: lp-pulse 2.8s ease-in-out infinite; }
    .lp-sec-title {
      font-family: var(--display); font-size: clamp(30px, 4vw, 48px); font-weight: 700;
      letter-spacing: -0.02em; line-height: 1.04; color: var(--ink); margin: 0 0 16px; text-wrap: balance;
    }
    .lp-sec-intro { font-size: clamp(16px, 1.3vw, 18px); line-height: 1.6; color: var(--ink-muted); margin: 0; }

    .lp-steps {
      list-style: none; margin: clamp(48px, 6vw, 76px) 0 0; padding: 0;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
    }
    .lp-step {
      display: flex; flex-direction: column;
      background: var(--surface); border: 1px solid var(--line); border-radius: 24px;
      padding: 28px 26px 26px; position: relative; overflow: hidden;
      box-shadow: 0 1px 2px rgba(20,24,31,0.04), 0 14px 34px -26px rgba(20,24,31,0.35);
      transition: transform .35s cubic-bezier(0.16,1,0.3,1), box-shadow .35s ease, border-color .35s ease;
    }
    .lp-step:hover { transform: translateY(-6px); border-color: rgba(27,42,74,0.20); box-shadow: 0 34px 64px -32px rgba(20,24,31,0.5); }
    .lp-step-num {
      font-family: var(--display); font-size: 13px; font-weight: 700; letter-spacing: 0.14em; color: var(--gold);
      display: inline-flex; align-items: center; gap: 8px;
    }
    .lp-step-num::after { content: ''; width: 22px; height: 1px; background: var(--gold); opacity: 0.6; }
    .lp-step-title { font-family: var(--display); font-size: 23px; font-weight: 700; letter-spacing: -0.015em; color: var(--ink); margin: 14px 0 10px; }
    .lp-step-text { font-size: 14.5px; line-height: 1.62; color: var(--ink-muted); margin: 0 0 22px; }
    .lp-step-visual {
      margin-top: auto; height: 150px; border-radius: 16px; position: relative; overflow: hidden;
      background: radial-gradient(125% 120% at 22% 12%, #33569E 0%, #1B2A4A 60%);
      display: flex; align-items: center; justify-content: center;
    }
    .lp-step-visual::after {
      content: ''; position: absolute; width: 150px; height: 150px; right: -44px; bottom: -54px;
      background: radial-gradient(circle, rgba(196,168,130,0.38), rgba(196,168,130,0) 70%); pointer-events: none;
    }
    .lp-step-visual svg { position: relative; z-index: 1; width: 62px; height: 62px; }

    @media (max-width: 980px) { .lp-steps { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .lp-steps { grid-template-columns: 1fr; } .lp-container { padding: 0 22px; } }

    /* ── ENTRANCE ── */
    .lp[data-anim-ready] [data-anim] { opacity: 0; transform: translateY(20px); }
    .lp[data-anim-ready] [data-drop] { opacity: 0; }

    /* ── RESPONSIVE ── */
    @media (max-width: 820px) {
      .lp-nav-inner, .lp-hero-content { padding-left: 22px; padding-right: 22px; }
      .lp-hero-content { padding-top: 110px; padding-bottom: 108px; }
      .lp-hero-text { padding: 42px 24px 30px; border-radius: 22px; }
      .lp-eyebrow { left: 22px; }
      .lp-hero-actions { right: 22px; left: 22px; bottom: 24px; justify-content: flex-start; }
      .lp-bg { width: 210vw; transform: translateY(66%); }
      .lp-scrim { background: linear-gradient(0deg, rgba(5,6,12,0.4) 0%, rgba(5,6,12,0) 40%), linear-gradient(90deg, rgba(5,6,12,0.6) 0%, rgba(5,6,12,0.1) 100%); }
    }
    @media (hover: none), (pointer: coarse) {
      .lp-cursor { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lp-cta, .lp-cta-circle, .lp-burger span, .lp-cursor { transition: none; }
      .lp-dot { animation: none; }
      .lp-cursor { display: none; }
    }
  </style>

  <script>
    import { gsap } from 'gsap';

    function initLanding(): void {
      const lp = document.querySelector<HTMLElement>('.lp');
      if (!lp || lp.dataset.wired === 'true') return;
      lp.dataset.wired = 'true';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fine = window.matchMedia('(pointer:fine)').matches;
      const anim = Array.from(document.querySelectorAll<HTMLElement>('[data-anim]'));

      /* Entrance */
      if (reduce) {
        anim.forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; });
      } else {
        lp.setAttribute('data-anim-ready', '');
        gsap.to(anim, {
          opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.1, delay: 0.1,
          onComplete: () => anim.forEach((el) => { el.style.transform = ''; }),
        });
      }

      /* Badge fällt zeitversetzt von oben, taucht zur Hälfte in die Karte ein
         und drückt dabei die Oberkante nach unten (Kerbe öffnet sich) — die
         gedrückte Kante bleibt stehen: 2,5-px-Naht rund um die Badge-Hälfte. */
      const drop = document.querySelector<HTMLElement>('[data-drop]');
      const cardBg = document.querySelector<HTMLElement>('.lp-card-bg');
      if (drop && cardBg) {
        const GAP = 2.5;
        // Kerbenbreite/-position aus der gemessenen Badge-Geometrie ableiten.
        const measureNotch = (): number => {
          const cr = cardBg.getBoundingClientRect();
          const br = drop.getBoundingClientRect();
          cardBg.style.setProperty('--nx', `${br.left - cr.left - GAP}px`);
          cardBg.style.setProperty('--nw', `${br.width + GAP * 2}px`);
          return br.height / 2 + GAP; // Tiefe = eingetauchte Hälfte + Naht
        };
        const nh = measureNotch();

        if (reduce) {
          cardBg.style.setProperty('--nh', `${nh}px`);
          drop.style.opacity = '1';
        } else {
          const tl = gsap.timeline({ delay: 0.7 });
          tl.fromTo(drop,
            { opacity: 0, y: -80, yPercent: -50 },
            { opacity: 1, y: 0, yPercent: -50, duration: 0.9, ease: 'power3.out' });
          // Kerbe öffnet sich sanft im letzten Teil des Falls (Kante gedrückt).
          tl.fromTo(cardBg,
            { '--nh': '0px' },
            { '--nh': `${nh}px`, duration: 0.6, ease: 'power2.out' }, '-=0.42');
        }
        // Bei Größenänderung Kerbe neu vermessen (statisch nachziehen).
        window.addEventListener('resize', () => {
          const f = measureNotch();
          cardBg.style.setProperty('--nh', `${f}px`);
        });
      }

      /* Parallax des Erd-Wraps (ruhige Tiefe) */
      const hero = document.querySelector<HTMLElement>('.lp-hero');
      const wrap = document.querySelector<HTMLElement>('.lp-bg-wrap');
      if (hero && wrap && fine && !reduce) {
        hero.addEventListener('mousemove', (e) => {
          const r = hero.getBoundingClientRect();
          const dx = (e.clientX - r.left) / r.width - 0.5;
          const dy = (e.clientY - r.top) / r.height - 0.5;
          gsap.to(wrap, { x: dx * -34, y: dy * -20, duration: 1.2, ease: 'power2.out' });
        });
        hero.addEventListener('mouseleave', () => gsap.to(wrap, { x: 0, y: 0, duration: 1.4, ease: 'power2.out' }));
      }

      /* Burger-Menü — kreisförmiges Aufblähen vom Button aus (barrierefrei) */
      const burger = document.querySelector<HTMLButtonElement>('.lp-burger');
      const menu = document.querySelector<HTMLElement>('#lp-menu');
      if (burger && menu) {
        const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
        const radius = (cx: number, cy: number): number =>
          Math.hypot(Math.max(cx, window.innerWidth - cx), Math.max(cy, window.innerHeight - cy));

        const openMenu = () => {
          const b = burger.getBoundingClientRect();
          const cx = b.left + b.width / 2, cy = b.top + b.height / 2;
          menu.style.setProperty('--cx', `${cx}px`);
          menu.style.setProperty('--cy', `${cy}px`);
          menu.hidden = false;
          burger.setAttribute('aria-expanded', 'true');
          burger.setAttribute('aria-label', 'Menü schließen');
          const r = radius(cx, cy) + 40;
          if (reduce) {
            menu.style.setProperty('--r', `${r}px`);
          } else {
            gsap.fromTo(menu, { '--r': '0px' }, { '--r': `${r}px`, duration: 0.7, ease: 'power3.inOut' });
            gsap.fromTo(links, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.08, delay: 0.28 });
          }
          links[0]?.focus();
        };
        const closeMenu = (focusBurger = true) => {
          burger.setAttribute('aria-expanded', 'false');
          burger.setAttribute('aria-label', 'Menü öffnen');
          if (focusBurger) burger.focus();
          if (reduce) { menu.hidden = true; menu.style.setProperty('--r', '0px'); return; }
          gsap.to(menu, { '--r': '0px', duration: 0.5, ease: 'power3.inOut', onComplete: () => { menu.hidden = true; } });
        };
        burger.addEventListener('click', () => (menu.hidden ? openMenu() : closeMenu()));
        links.forEach((a) => a.addEventListener('click', () => closeMenu(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) closeMenu(); });
        menu.addEventListener('click', (e) => { if (e.target === menu) closeMenu(); });
      }

      /* orizon-artiger Cursor */
      const cursor = document.querySelector<HTMLElement>('.lp-cursor');
      if (cursor && fine && !reduce) {
        const xTo = gsap.quickTo(cursor, 'x', { duration: 0.4, ease: 'power3' });
        const yTo = gsap.quickTo(cursor, 'y', { duration: 0.4, ease: 'power3' });
        gsap.set(cursor, { xPercent: -50, yPercent: -50 });
        window.addEventListener('mousemove', (e) => {
          cursor.classList.add('is-active');
          xTo(e.clientX); yTo(e.clientY);
        });
        window.addEventListener('mouseout', (e) => { if (!e.relatedTarget) cursor.classList.remove('is-active'); });
        document.addEventListener('mouseover', (e) => {
          const t = (e.target as HTMLElement).closest('a, button');
          cursor.classList.toggle('is-hover', !!t);
        });
      }

      /* Scroll-Reveals (ruhig, gestaffelt je Gruppe) */
      const reveals = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (reveals.length) {
        if (reduce) {
          reveals.forEach((el) => { el.style.opacity = '1'; });
        } else {
          gsap.set(reveals, { opacity: 0, y: 28 });
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const el = e.target as HTMLElement;
              gsap.to(el, { opacity: 1, y: 0, duration: 0.75, ease: 'power3.out', delay: (Number(el.dataset.i) || 0) * 0.09 });
              io.unobserve(el);
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
          reveals.forEach((el) => {
            const parent = el.parentElement;
            el.dataset.i = parent && parent.classList.contains('lp-steps')
              ? String(Array.prototype.indexOf.call(parent.children, el))
              : '0';
            io.observe(el);
          });
        }
      }
    }

    document.addEventListener('astro:page-load', initLanding);
  </script>
</BaseLayout>
