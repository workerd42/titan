---
/**
 * /willkommen — öffentliche Marketing-Landingpage (B2B-first, immersiver Stil).
 * On-demand, aber ÖFFENTLICH (Middleware-Allowlist). Wird Section für Section
 * aufgebaut/abgestimmt. Palette: Kosmos-Blau (Navy) + Titan-Gold.
 * Hero: Blue-Marble-Erde unten-mittig (Screen-Blend, nahtlos), Nav = Wortmarke +
 * Burger, dessen Overlay sich kreisförmig über den Screen aufbläht.
 * Self-hosted Fonts (Space Grotesk / Inter). GSAP; prefers-reduced-motion.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const NAV = [
  { href: '#fachwirte', label: 'Fachrichtungen' },
  { href: '#angebot', label: 'Angebot' },
  { href: '#vertrauen', label: 'Vertrauen' },
];

// CTA v1: mailto. E-Mail ist ein PLATZHALTER — vom Betreiber bestätigen/ersetzen.
const KONTAKT_EMAIL = 'service@norive.de';
const KONTAKT_MAILTO = `mailto:${KONTAKT_EMAIL}?subject=${encodeURIComponent('Demo-Anfrage – Titan')}&body=${encodeURIComponent(
  'Hallo Titan-Team,\n\nich interessiere mich für eine Demo von Titan.\n\nName / Einrichtung:\nAnzahl Kurse / Teilnehmende:\nWunschtermin:\n\nViele Grüße'
)}`;
---

<BaseLayout
  title="Für Bildungsträger"
  description="Die IHK-Fachwirt-Vorbereitung als interaktives Kompetenz-Erlebnis — für Bildungsträger, die Bestehensquote und Kurs-Qualität steigern."
  canonicalPath="/willkommen/"
  theme="light"
>
  <main id="hauptinhalt" class="lp">
    <!-- ── HERO (Vollbild) ─────────────────────────────── -->
    <section class="lp-hero">
      <div class="lp-bg-wrap" aria-hidden="true">
        <img class="lp-bg" src={`${base}willkommen/hero-earth.jpg`} alt="" width="2560" height="2560" />
      </div>
      <div class="lp-scrim" aria-hidden="true"></div>

      <!-- Hero-Inhalt -->
      <div class="lp-hero-content">
        <div class="lp-hero-text">
          <div class="lp-card-bg" aria-hidden="true"></div>
          <span class="lp-eyebrow" data-drop><i class="lp-dot" aria-hidden="true"></i> Interaktive IHK-Fachwirt-Vorbereitung</span>
          <h1 class="lp-h1" data-anim>Vom Wissen<br />zur <span class="lp-accent">Wirkung.</span></h1>
          <p class="lp-sub" data-anim>Die Learning Experience Platform (LXP), die anspruchsvolle Curricula in exzellente Lernerlebnisse übersetzt – für höchste Kursqualität und maximale Erfolgsquoten.</p>
        </div>
      </div>

      <!-- Aktionen: frei unten rechts (locker, außerhalb des Glases) -->
      <div class="lp-hero-actions" data-anim>
        <a class="lp-cta" href={KONTAKT_MAILTO}>
          <span>Demo anfragen</span>
          <span class="lp-cta-circle" aria-hidden="true">↗</span>
        </a>
        <a class="lp-ghost" href="#wie">So funktioniert's</a>
      </div>
    </section>

    <!-- Navigation (außerhalb des Hero-Stapelkontexts, damit der Burger als
         X über dem Menü-Overlay sichtbar/klickbar bleibt) -->
    <header class="lp-nav">
      <div class="lp-nav-inner">
        <a class="lp-brand" href={`${base}willkommen/`}>Titan</a>
        <button type="button" class="lp-burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="lp-menu">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <!-- ── Menü-Overlay (kreisförmiges Aufblähen vom Burger) ── -->
    <div class="lp-menu" id="lp-menu" hidden>
      <nav class="lp-menu-nav" aria-label="Menü">
        {NAV.map((n) => <a class="lp-menu-link" href={n.href}>{n.label}</a>)}
        <a class="lp-menu-cta" href={KONTAKT_MAILTO}>Kontakt aufnehmen <span aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <!-- ── SECTION 1 · So funktioniert's (4-Phasen-Reise) ── -->
    <section class="lp-how" id="wie">
      <div class="lp-container">
        <header class="lp-sec-head" data-reveal>
          <span class="lp-sec-eyebrow"><i class="lp-dot" aria-hidden="true"></i> So funktioniert's</span>
          <h2 class="lp-sec-title">In vier Phasen zur Wirkung</h2>
          <p class="lp-sec-intro">Ein durchgängiger roter Faden statt loser Kapitel — von der ersten Idee bis zur fertigen Prüfungsleistung.</p>
        </header>

        <ol class="lp-steps">
          <li class="lp-step" data-reveal>
            <span class="lp-step-num">01</span>
            <h3 class="lp-step-title">Verstehen</h3>
            <p class="lp-step-text">Anspruchsvolle Fachinhalte als interaktive Erlebnisse begreifen — nicht auswendig lernen, sondern wirklich durchdringen.</p>
            <div class="lp-step-visual" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" width="58" height="58">
                <circle cx="32" cy="19" r="7" stroke="#fff" stroke-width="2"/>
                <circle cx="17" cy="45" r="6" stroke="#fff" stroke-width="2"/>
                <circle cx="47" cy="45" r="6" stroke="#C4A882" stroke-width="2"/>
                <path d="M32 26 L18 39 M32 26 L46 39" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
          </li>
          <li class="lp-step" data-reveal>
            <span class="lp-step-num">02</span>
            <h3 class="lp-step-title">Merken</h3>
            <p class="lp-step-text">Wissen verankern: kompakte Karten und Wiederholung im richtigen Moment sorgen für nachhaltiges Behalten.</p>
            <div class="lp-step-visual" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" width="58" height="58">
                <rect x="14" y="17" width="28" height="20" rx="3" stroke="#fff" stroke-width="2"/>
                <rect x="22" y="27" width="28" height="20" rx="3" stroke="#C4A882" stroke-width="2"/>
              </svg>
            </div>
          </li>
          <li class="lp-step" data-reveal>
            <span class="lp-step-num">03</span>
            <h3 class="lp-step-title">Anwenden</h3>
            <p class="lp-step-text">An einer durchgängigen Fallfirma mit praxisnahen Werkzeugen arbeiten — von der Analyse bis zur begründeten Entscheidung.</p>
            <div class="lp-step-visual" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" width="58" height="58">
                <line x1="14" y1="25" x2="50" y2="25" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                <circle cx="41" cy="25" r="5" fill="#C4A882"/>
                <line x1="14" y1="41" x2="50" y2="41" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                <circle cx="24" cy="41" r="5" fill="#fff"/>
              </svg>
            </div>
          </li>
          <li class="lp-step" data-reveal>
            <span class="lp-step-num">04</span>
            <h3 class="lp-step-title">Prüfen</h3>
            <p class="lp-step-text">Prüfungsnah testen — und ganz nebenbei entsteht ein präsentationsreifes Ergebnis für die mündliche Prüfung.</p>
            <div class="lp-step-visual" aria-hidden="true">
              <svg viewBox="0 0 64 64" fill="none" width="58" height="58">
                <rect x="20" y="13" width="24" height="32" rx="3" stroke="#fff" stroke-width="2"/>
                <path d="M26 39 l5 5 l9 -12" stroke="#C4A882" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </li>
        </ol>
        <div class="lp-divider" role="presentation"></div>
      </div>
    </section>

    <!-- ── SECTION 2 · Fachrichtungen (Galerie) ── -->
    <section class="lp-fields-sec" id="fachwirte">
      <div class="lp-container">
        <header class="lp-sec-head lp-fields-head" data-reveal>
          <div>
            <span class="lp-sec-eyebrow"><i class="lp-dot" aria-hidden="true"></i> Fachrichtungen</span>
            <h2 class="lp-sec-title">Eine Plattform, viele Fachwirte</h2>
            <p class="lp-sec-intro">Titan ist fachrichtungsübergreifend angelegt. Der Marketing-Fachwirt ist live — weitere Richtungen entstehen laufend.</p>
          </div>
        </header>
      </div>

      <div class="lp-marquee" role="group" aria-label="Fachrichtungen">
        <div class="lp-marquee-track" data-marquee>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-live">Verfügbar</span><h3 class="lp-field-name">Marketing</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="13" stroke="#fff" stroke-width="2"/><circle cx="24" cy="24" r="5" stroke="#C4A882" stroke-width="2"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Wirtschaft</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M10 31 L20 22 L28 27 L38 14" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M38 14h-7 M38 14v7" stroke="#C4A882" stroke-width="2" stroke-linecap="round"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Industrie</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M12 36V22l8 5v-5l8 5V16h8v20z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/><path d="M34 16v-4" stroke="#C4A882" stroke-width="2" stroke-linecap="round"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Handel</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M14 18h20l-2 18H16z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/><path d="M19 18a5 5 0 0 1 10 0" stroke="#C4A882" stroke-width="2"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Technik</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="7" stroke="#fff" stroke-width="2"/><path d="M24 10v5 M24 33v5 M10 24h5 M33 24h5 M14 14l3.5 3.5 M34 34l-3.5-3.5" stroke="#C4A882" stroke-width="2" stroke-linecap="round"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Immobilien</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><rect x="14" y="14" width="20" height="22" stroke="#fff" stroke-width="2"/><path d="M19 20h4 M25 20h4 M19 26h4 M25 26h4" stroke="#C4A882" stroke-width="2" stroke-linecap="round"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Logistik</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><rect x="10" y="18" width="18" height="12" stroke="#fff" stroke-width="2"/><path d="M28 22h6l4 4v4H28z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/><circle cx="17" cy="32" r="2.5" fill="#C4A882"/><circle cx="32" cy="32" r="2.5" fill="#C4A882"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Gesundheit &amp; Soziales</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M20 12h8v8h8v8h-8v8h-8v-8h-8v-8h8z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Banken</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M12 20 L24 12 L36 20" stroke="#fff" stroke-width="2" stroke-linejoin="round"/><path d="M16 22v10 M22 22v10 M28 22v10 M34 22v10" stroke="#fff" stroke-width="2"/><path d="M12 34h24" stroke="#C4A882" stroke-width="2" stroke-linecap="round"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Versicherungen &amp; Finanzen</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M24 12l12 4v8c0 7-5 11-12 14-7-3-12-7-12-14v-8z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/><path d="M19 24l4 4 6-8" stroke="#C4A882" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Medien</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><rect x="12" y="14" width="24" height="20" rx="3" stroke="#fff" stroke-width="2"/><path d="M22 21l7 3-7 3z" fill="#C4A882"/></svg></div>
          </article>
          <article class="lp-field">
            <div class="lp-field-body"><span class="lp-field-status is-soon">In Vorbereitung</span><h3 class="lp-field-name">Tourismus</h3></div>
            <div class="lp-field-visual" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="12" stroke="#fff" stroke-width="2"/><path d="M29 19l-3 8-8 3 3-8z" stroke="#C4A882" stroke-width="2" stroke-linejoin="round"/></svg></div>
          </article>
        </div>
      </div>

      <div class="lp-container">
        <a class="lp-viewall" href={`${base}fachrichtungen/`}>Alle Fachrichtungen ansehen <span aria-hidden="true">↗</span></a>
        <div class="lp-divider" role="presentation"></div>
      </div>
    </section>

    <!-- ── SECTION 3 · Für wen (B2B & B2C) · Scroll: Text → Cards ── -->
    <section class="lp-offers-sec" id="angebot">
      <div class="lp-offers-scroll">
        <div class="lp-offers-stage">
          <div class="lp-offers-head" data-offers-head>
            <span class="lp-sec-eyebrow"><i class="lp-dot" aria-hidden="true"></i> Angebot</span>
            <h2 class="lp-sec-title">Für Bildungsträger und Prüflinge</h2>
            <p class="lp-sec-intro">Titan bringt beide Seiten zusammen — messbar bessere Kurse für Träger, ein ruhigerer Weg zur Prüfung für Lernende.</p>
          </div>

          <div class="lp-offers-cardswrap" data-offers-cards>
            <div class="lp-container">
              <div class="lp-offers">
                <article class="lp-offer">
                  <div class="lp-offer-icon" aria-hidden="true">
                    <svg viewBox="0 0 36 36" fill="none">
                      <path d="M8 30V13l10-6 10 6v17" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
                      <path d="M14 30v-7h8v7" stroke="#C4A882" stroke-width="2" stroke-linejoin="round"/>
                      <path d="M13 15h3 M20 15h3" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </div>
                  <span class="lp-offer-eyebrow">Für Bildungsträger · B2B</span>
                  <h3 class="lp-offer-title">Bessere Kurse, höhere Erfolgsquoten</h3>
                  <p class="lp-offer-desc">Setzen Sie Titan im Präsenz- und Online-Unterricht ein — pro Kurs lizenzierbar, individuelles Angebot.</p>
                  <ul class="lp-offer-list">
                    <li>Dozenten-Cockpit: Fortschritt der Kohorte im Blick</li>
                    <li>Höhere Bestehensquote &amp; klare Differenzierung</li>
                    <li>Didaktisch fundiert durch erfahrene Fachdozenten</li>
                    <li>EU/DE-Hosting, DSGVO-konform</li>
                  </ul>
                  <a class="lp-offer-cta" href={KONTAKT_MAILTO}>Demo anfragen <span aria-hidden="true">↗</span></a>
                </article>

                <article class="lp-offer">
                  <div class="lp-offer-icon" aria-hidden="true">
                    <svg viewBox="0 0 36 36" fill="none">
                      <path d="M18 8 4 14l14 6 14-6z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
                      <path d="M10 17v6c0 2 3.5 3 8 3s8-1 8-3v-6" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
                      <path d="M31 14v6" stroke="#C4A882" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </div>
                  <span class="lp-offer-eyebrow">Für Prüflinge · B2C</span>
                  <h3 class="lp-offer-title">Weniger Stress, mehr Wirkung</h3>
                  <p class="lp-offer-desc">Lernen an echten Fällen statt trockener Skripte — mit durchgehendem roten Faden bis zur Prüfung.</p>
                  <ul class="lp-offer-list">
                    <li>An der eigenen Fallfirma üben</li>
                    <li>Interaktive Werkzeuge statt Auswendiglernen</li>
                    <li>Prüfungsreifes Ergebnis als Nebenprodukt</li>
                    <li>Ruhiges, motivierendes Lernerlebnis</li>
                  </ul>
                  <a class="lp-offer-cta" href={`${base}so-funktionierts/`}>So funktioniert's <span aria-hidden="true">↗</span></a>
                </article>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SECTION 4 · Warum Titan (gestapelte Scroll-Cards) ── -->
    <section class="lp-why-sec" id="warum">
      <div class="lp-container">
        <div class="lp-divider" role="presentation"></div>
      </div>

      <div class="lp-deal-scroll">
        <div class="lp-deal-stage">
          <article class="lp-deal-card">
            <div class="lp-deal-top">
              <div class="lp-deal-head">
                <span class="lp-sec-eyebrow"><i class="lp-dot" aria-hidden="true"></i> Warum Titan</span>
                <h2 class="lp-deal-h">Was Titan anders macht</h2>
                <p class="lp-deal-lead">Drei Gründe, warum aus Prüfungsvorbereitung echte Kompetenz wird.</p>
              </div>
              <div class="lp-deal-media" aria-hidden="true">
                <svg viewBox="0 0 220 160" fill="none"><path d="M18 132 C 70 132, 55 40, 110 44 C 165 48, 150 118, 202 96" stroke="#C4A882" stroke-width="3" stroke-linecap="round"/><circle cx="18" cy="132" r="6" fill="#fff"/><circle cx="110" cy="44" r="6" fill="#fff"/><circle cx="202" cy="96" r="6" fill="#C4A882"/></svg>
              </div>
            </div>
            <div class="lp-deal-cols">
              <div class="lp-deal-col">
                <h4>Eine Reise, kein Flickenteppich</h4>
                <p>Jede Phase baut auf der vorigen auf — vom ersten Konzept bis zur fertigen Prüfungsleistung.</p>
              </div>
              <div class="lp-deal-col">
                <h4>Nie den Überblick verlieren</h4>
                <p>Statt wechselnder Dozenten und loser Kapitel führt ein klarer Pfad sicher zum Ziel.</p>
              </div>
            </div>
          </article>

          <article class="lp-deal-card">
            <div class="lp-deal-top">
              <h3 class="lp-deal-h">An der eigenen<br />Fallfirma üben</h3>
              <div class="lp-deal-media" aria-hidden="true">
                <svg viewBox="0 0 220 160" fill="none"><rect x="24" y="26" width="172" height="108" rx="10" stroke="#fff" stroke-width="2.5"/><path d="M24 52 H196" stroke="#fff" stroke-width="2"/><circle cx="39" cy="39" r="3" fill="#C4A882"/><line x1="48" y1="80" x2="172" y2="80" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/><circle cx="140" cy="80" r="7" fill="#C4A882"/><line x1="48" y1="108" x2="172" y2="108" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/><circle cx="80" cy="108" r="7" fill="#fff"/></svg>
              </div>
            </div>
            <div class="lp-deal-cols">
              <div class="lp-deal-col">
                <h4>Handeln statt auswendig lernen</h4>
                <p>Interaktive Werkzeuge begleiten von der Analyse bis zur begründeten Entscheidung.</p>
              </div>
              <div class="lp-deal-col">
                <h4>Genau wie in der Prüfung</h4>
                <p>Die Aufgaben spiegeln die echten Anforderungen der IHK-Prüfung wider.</p>
              </div>
            </div>
          </article>

          <article class="lp-deal-card">
            <div class="lp-deal-top">
              <h3 class="lp-deal-h">Das Deck als<br />Nebenprodukt</h3>
              <div class="lp-deal-media" aria-hidden="true">
                <svg viewBox="0 0 220 160" fill="none"><rect x="40" y="28" width="140" height="94" rx="8" stroke="#fff" stroke-width="2.5"/><path d="M40 106 H180" stroke="#fff" stroke-width="2"/><line x1="58" y1="52" x2="120" y2="52" stroke="#C4A882" stroke-width="3" stroke-linecap="round"/><line x1="58" y1="70" x2="150" y2="70" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/><line x1="58" y1="86" x2="132" y2="86" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/><path d="M96 136 h28 M110 122 v14" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>
              </div>
            </div>
            <div class="lp-deal-cols">
              <div class="lp-deal-col">
                <h4>Ergebnis fällt nebenbei an</h4>
                <p>Während des Übens entsteht Schritt für Schritt ein präsentationsreifes Deck.</p>
              </div>
              <div class="lp-deal-col">
                <h4>Bereit für die mündliche Prüfung</h4>
                <p>Kein mühsames Zusammenstellen am Ende — das Ergebnis ist prüfungsfertig.</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- orizon-artiger Cursor (nur Zeiger-Geräte, JS-gesteuert) -->
    <div class="lp-cursor" aria-hidden="true"></div>
  </main>

  <style>
    /* ── Self-hosted Fonts (latin, deckt DE-Umlaute + ß) ── */
    @font-face { font-family: 'Space Grotesk'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/SpaceGrotesk-500.woff2') format('woff2'); }
    @font-face { font-family: 'Space Grotesk'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/SpaceGrotesk-700.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/Inter-400.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/Inter-500.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/Inter-600.woff2') format('woff2'); }

    /* ── Landing-Palette ── */
    .lp {
      --bg: #EFEDE7;
      --ink: #14181F;
      --navy: #1B2A4A;
      --gold: #C4A882;
      --ink-muted: #5A6172;
      --surface: #FFFFFF;
      --line: rgba(20,24,31,0.10);
      --on: #F5F6F8;
      --on-muted: rgba(245,246,248,0.80);
      --on-faint: rgba(245,246,248,0.16);
      --display: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

      background: var(--bg);
      font-family: var(--body);
      color: var(--ink);
    }
    .lp * { box-sizing: border-box; }

    /* ── HERO Grundgerüst (Vollbild) ── */
    .lp-hero {
      position: relative;
      min-height: 100vh; min-height: 100svh;
      overflow: hidden; display: flex; isolation: isolate;
      background: radial-gradient(125% 95% at 50% 122%, #0d1830 0%, #070b16 52%, #05060c 100%);
    }
    /* Erde: unten-mittig aufsteigend; Screen-Blend blendet den schwarzen
       Bildhintergrund aus → nahtlos, keine sichtbaren Bildkanten. */
    .lp-bg-wrap {
      position: absolute; left: 0; right: 0; bottom: 0; z-index: -1;
      display: flex; justify-content: center; will-change: transform;
    }
    .lp-bg {
      width: min(1500px, 165vw); height: auto;
      transform: translateY(62%);
      mix-blend-mode: screen;
      /* Radial-Maske blendet die JPEG-Kanten/Ecken weg → keine Bild-Kante. */
      -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 60%, transparent 71%);
      mask-image: radial-gradient(circle at 50% 50%, #000 60%, transparent 71%);
      -webkit-user-select: none; user-select: none; pointer-events: none;
    }
    .lp-scrim {
      position: absolute; inset: 0; z-index: -1;
      background: linear-gradient(90deg, rgba(5,6,12,0.30) 0%, rgba(5,6,12,0.04) 44%, rgba(5,6,12,0) 62%);
    }

    /* ── NAV (nur Wortmarke + Burger) ── */
    /* z-index über dem Menü-Overlay (30), damit der Burger als klickbares X
       sichtbar bleibt und das Menü schließen kann. */
    .lp-nav { position: absolute; top: 0; left: 0; right: 0; z-index: 50; }
    .lp-nav-inner {
      max-width: 1360px; margin: 0 auto; padding: 26px 32px;
      display: flex; align-items: center; justify-content: space-between; gap: 24px;
    }
    .lp-brand { font-family: var(--display); font-size: 24px; font-weight: 700; letter-spacing: -0.01em; color: var(--on); text-decoration: none; }

    /* Burger */
    .lp-burger {
      position: relative; z-index: 40;
      width: 52px; height: 44px; border-radius: 999px;
      border: 1px solid var(--on-faint); background: rgba(245,246,248,0.04); backdrop-filter: blur(6px);
      display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px;
      cursor: pointer; transition: border-color .2s ease, background .2s ease;
    }
    .lp-burger:hover { border-color: rgba(245,246,248,0.5); background: rgba(245,246,248,0.09); }
    .lp-burger span { display: block; width: 20px; height: 2px; border-radius: 2px; background: var(--on); transition: transform .3s cubic-bezier(0.16,1,0.3,1), opacity .2s ease; }
    .lp-burger[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .lp-burger[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    .lp-burger:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

    /* ── HERO-INHALT ── */
    .lp-hero-content {
      max-width: 1360px; width: 100%; margin: 0 auto;
      padding: 120px 32px; display: flex; align-items: center;
    }
    .lp-hero-text {
      /* Karte umschließt ihren breitesten Inhalt (die Headline), damit das
         Glas den kompletten Text hinterlegt — auf jedem Endgerät. */
      position: relative;
      width: fit-content; max-width: min(100%, 1040px); min-width: 0;
      padding: 46px 46px 46px;
    }
    /* Glas-Hintergrund als EIGENE Ebene: Die Kerbe (Mask) beschneidet nur
       diese Ebene — Badge & Text liegen darüber und werden NICHT abgeschnitten.
       2. Mask-Ebene (Rechteck an Badge-Position) wird ausgeschnitten; --nw/--nh
       per JS gesetzt/animiert → die Oberkante wird beim Auftreffen nach unten
       gedrückt und bleibt so stehen (2,5-px-Naht um die eingetauchte Hälfte). */
    .lp-card-bg {
      position: absolute; inset: 0; z-index: 0;
      background: rgba(8,12,20,0.32);
      -webkit-backdrop-filter: blur(18px) saturate(115%);
      backdrop-filter: blur(18px) saturate(115%);
      border: 1px solid rgba(245,246,248,0.10);
      border-radius: 28px;
      --nx: 40px; --nw: 0px; --nh: 0px;
      /* Kerbe ohne mask-composite: drei Bänder (links / rechts / unten)
         vereinen sich (Standard-Union) zu „alles außer dem Kerben-Rechteck". */
      -webkit-mask-image: linear-gradient(#000,#000), linear-gradient(#000,#000), linear-gradient(#000,#000);
      mask-image: linear-gradient(#000,#000), linear-gradient(#000,#000), linear-gradient(#000,#000);
      -webkit-mask-repeat: no-repeat, no-repeat, no-repeat;
      mask-repeat: no-repeat, no-repeat, no-repeat;
      -webkit-mask-position: 0 0, calc(var(--nx) + var(--nw)) 0, 0 var(--nh);
      mask-position: 0 0, calc(var(--nx) + var(--nw)) 0, 0 var(--nh);
      -webkit-mask-size: var(--nx) 100%, calc(100% - var(--nx) - var(--nw)) 100%, 100% calc(100% - var(--nh));
      mask-size: var(--nx) 100%, calc(100% - var(--nx) - var(--nw)) 100%, 100% calc(100% - var(--nh));
    }
    .lp-h1, .lp-sub { position: relative; z-index: 1; }

    /* Badge taucht zur Hälfte in die Glaskarte ein (halb überlappend) und
       durchbricht so die obere Kante — wie hineingefallen. */
    .lp-eyebrow {
      position: absolute; top: 0; left: 40px; transform: translateY(-50%); z-index: 2;
      display: inline-flex; align-items: center; gap: 10px;
      font-size: 12.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase;
      color: var(--on);
      border: 1px solid rgba(245,246,248,0.14); border-radius: 999px; padding: 10px 18px 10px 14px;
      background: rgba(12,17,27,0.85); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
      box-shadow: 0 12px 28px -12px rgba(0,0,0,0.7);
      white-space: nowrap;
    }
    .lp-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); animation: lp-pulse 2.8s ease-in-out infinite; }
    @keyframes lp-pulse {
      0%, 100% { box-shadow: 0 0 0 3px rgba(196,168,130,0.26), 0 0 6px 1px rgba(196,168,130,0.35); }
      50%      { box-shadow: 0 0 0 7px rgba(196,168,130,0.04), 0 0 12px 3px rgba(196,168,130,0.15); }
    }

    .lp-h1 {
      font-family: var(--display);
      font-size: clamp(46px, 7vw, 92px); font-weight: 700; line-height: 0.98;
      letter-spacing: -0.03em; color: var(--on); margin: 0 0 24px; text-wrap: balance;
      overflow-wrap: break-word; hyphens: auto;
    }
    .lp-accent { position: relative; white-space: nowrap; }
    .lp-accent::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0.06em; height: 0.09em;
      background: var(--gold); border-radius: 4px;
    }
    .lp-sub { font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; color: var(--on-muted); max-width: 46ch; margin: 0 0 34px; }

    /* Aktionen frei unten rechts im Hero (locker) */
    .lp-hero-actions {
      position: absolute; right: 32px; bottom: 40px; z-index: 5;
      display: flex; align-items: center; gap: 20px; flex-wrap: wrap; justify-content: flex-end;
    }
    .lp-cta {
      display: inline-flex; align-items: center; gap: 14px;
      background: var(--on); color: var(--navy); text-decoration: none;
      font-size: 15px; font-weight: 600; border-radius: 999px; padding: 8px 8px 8px 24px;
      box-shadow: 0 14px 34px -14px rgba(0,0,0,0.6);
      transition: box-shadow .25s ease, background .25s ease;
    }
    .lp-cta:hover { box-shadow: 0 18px 40px -14px rgba(0,0,0,0.75); background: #fff; }
    .lp-cta-circle { width: 38px; height: 38px; border-radius: 50%; background: var(--gold); color: var(--navy); display: inline-flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 700; transition: transform .35s cubic-bezier(0.16,1,0.3,1); }
    .lp-cta:hover .lp-cta-circle { transform: rotate(45deg); }
    .lp-ghost { font-size: 15px; font-weight: 600; color: var(--on); text-decoration: none; border-bottom: 2px solid var(--on-faint); padding-bottom: 3px; text-shadow: 0 1px 14px rgba(0,0,0,0.55); transition: border-color .2s ease; }
    .lp-ghost:hover { border-color: rgba(245,246,248,0.55); }
    .lp-cta:focus-visible, .lp-ghost:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 4px; }

    /* ── MENÜ-OVERLAY (kreisförmiges Aufblähen) ── */
    .lp-menu {
      position: fixed; inset: 0; z-index: 30;
      background: rgba(6,10,18,0.94); backdrop-filter: blur(16px);
      display: flex; align-items: center; justify-content: center;
      clip-path: circle(var(--r, 0px) at var(--cx, 100%) var(--cy, 0px));
    }
    .lp-menu[hidden] { display: none; }
    .lp-menu-nav { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
    .lp-menu-link {
      font-family: var(--display); font-size: clamp(34px, 6vw, 60px); font-weight: 700;
      letter-spacing: -0.02em; color: var(--on); text-decoration: none; line-height: 1.15;
      opacity: 0.9; transition: opacity .2s ease, color .2s ease;
    }
    .lp-menu-link:hover { opacity: 1; color: var(--gold); }
    .lp-menu-cta {
      margin-top: 28px; font-family: var(--body); font-size: 17px; font-weight: 600;
      color: var(--navy); background: var(--on); text-decoration: none;
      border-radius: 999px; padding: 14px 30px; transition: background .2s ease;
    }
    .lp-menu-cta:hover { background: var(--gold); }
    .lp-menu a:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; border-radius: 6px; }

    /* ── CURSOR (orizon-artig) ── */
    .lp-cursor {
      position: fixed; top: 0; left: 0; width: 12px; height: 12px; border-radius: 50%;
      background: #fff; mix-blend-mode: difference; pointer-events: none; z-index: 60;
      transform: translate(-50%, -50%); opacity: 0;
      transition: width .25s ease, height .25s ease, background .25s ease, opacity .25s ease;
    }
    .lp-cursor.is-active { opacity: 1; }
    .lp-cursor.is-hover { width: 46px; height: 46px; background: rgba(255,255,255,0.85); }

    /* ── LAYOUT-CONTAINER ── */
    .lp-container { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 0 32px; }

    /* ── SECTION 1 · So funktioniert's (heller Grund, „Licht geht an") ── */
    .lp-how { position: relative; background: var(--bg); color: var(--ink); padding: clamp(84px, 10vw, 148px) 0 0; }
    .lp-sec-head { max-width: 640px; }
    .lp-sec-eyebrow {
      display: inline-flex; align-items: center; gap: 9px;
      font-size: 12.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--navy); margin-bottom: 18px;
    }
    .lp-sec-eyebrow .lp-dot { animation: lp-pulse 2.8s ease-in-out infinite; }
    .lp-sec-title {
      font-family: var(--display); font-size: clamp(30px, 4vw, 48px); font-weight: 700;
      letter-spacing: -0.02em; line-height: 1.04; color: var(--ink); margin: 0 0 16px; text-wrap: balance;
    }
    .lp-sec-intro { font-size: clamp(16px, 1.3vw, 18px); line-height: 1.6; color: var(--ink-muted); margin: 0; }

    .lp-steps {
      list-style: none; margin: clamp(48px, 6vw, 76px) 0 0; padding: 0;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
    }
    /* Ganze Card im Navy-Gold-Farbschema (Icon bleibt unten an seiner Position) */
    .lp-step {
      display: flex; flex-direction: column; min-height: 336px;
      background: radial-gradient(140% 130% at 20% 8%, #33569E 0%, #1B2A4A 58%);
      border: 1px solid rgba(255,255,255,0.10); border-radius: 24px;
      padding: 28px 26px 26px; position: relative; overflow: hidden;
      box-shadow: 0 18px 40px -26px rgba(12,20,36,0.7);
      transition: transform .35s cubic-bezier(0.16,1,0.3,1), box-shadow .35s ease, border-color .35s ease;
    }
    .lp-step::after {
      content: ''; position: absolute; width: 190px; height: 190px; right: -60px; bottom: -70px;
      background: radial-gradient(circle, rgba(196,168,130,0.30), rgba(196,168,130,0) 70%); pointer-events: none;
    }
    .lp-step:hover { transform: translateY(-6px); border-color: rgba(255,255,255,0.24); box-shadow: 0 40px 72px -30px rgba(12,20,36,0.85); }
    .lp-step-num {
      position: relative; z-index: 1;
      font-family: var(--display); font-size: 13px; font-weight: 700; letter-spacing: 0.14em; color: var(--gold);
      display: inline-flex; align-items: center; gap: 8px;
    }
    .lp-step-num::after { content: ''; width: 22px; height: 1px; background: var(--gold); opacity: 0.6; }
    .lp-step-title { position: relative; z-index: 1; font-family: var(--display); font-size: 23px; font-weight: 700; letter-spacing: -0.015em; color: #F5F6F8; margin: 14px 0 10px; }
    .lp-step-text { position: relative; z-index: 1; font-size: 14.5px; line-height: 1.62; color: rgba(245,246,248,0.76); margin: 0 0 22px; }
    .lp-step-visual {
      position: relative; z-index: 1; margin-top: auto; height: 96px;
      display: flex; align-items: center; justify-content: center;
    }
    .lp-step-visual svg { width: 62px; height: 62px; }

    @media (max-width: 980px) { .lp-steps { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .lp-steps { grid-template-columns: 1fr; } .lp-container { padding: 0 22px; } }

    /* Trennstrich am Ende von Section 1 (klar erkennbar, symmetrisch umschlossen) */
    .lp-divider { height: 1px; background: rgba(20,24,31,0.16); margin: clamp(58px, 7vw, 92px) 0 0; }

    /* ── SECTION 2 · Fachrichtungen (Galerie) ── */
    /* Oben symmetrisch zum Trenner-Abstand → einheitliche Fläche um die Linie. */
    .lp-fields-sec { background: var(--bg); color: var(--ink); padding: clamp(58px, 7vw, 92px) 0 0; }
    .lp-fields-head { max-width: none; display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
    .lp-fields-head > div:first-child { max-width: 640px; }

    /* Fortlaufendes Endlos-Karussell über die volle Breite (full-bleed) */
    .lp-marquee {
      margin-top: clamp(40px, 5vw, 64px); width: 100%; overflow: hidden; padding: 14px 0 44px;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
    }
    .lp-marquee-track { display: flex; width: max-content; animation: lp-marquee 64s linear infinite; will-change: transform; }
    .lp-marquee:hover .lp-marquee-track { animation-play-state: paused; }
    @keyframes lp-marquee { to { transform: translateX(-50%); } }

    /* Cards im Navy-Gold-Schema (Höhe wie Section 1), Icon unten */
    .lp-field {
      flex: 0 0 269px; min-height: 336px; margin-right: 18px;
      display: flex; flex-direction: column;
      background: radial-gradient(140% 130% at 20% 8%, #33569E 0%, #1B2A4A 58%);
      border: 1px solid rgba(255,255,255,0.10); border-radius: 24px;
      padding: 28px 26px 26px; position: relative; overflow: hidden;
      box-shadow: 0 26px 46px -30px rgba(12,20,36,0.5);
      transition: transform .35s cubic-bezier(0.16,1,0.3,1), box-shadow .35s ease, border-color .35s ease;
    }
    .lp-field::after {
      content: ''; position: absolute; width: 190px; height: 190px; right: -60px; bottom: -70px;
      background: radial-gradient(circle, rgba(196,168,130,0.30), rgba(196,168,130,0) 70%); pointer-events: none;
    }
    .lp-field:hover { transform: translateY(-6px); border-color: rgba(255,255,255,0.24); box-shadow: 0 40px 72px -30px rgba(12,20,36,0.85); }
    .lp-field-body { position: relative; z-index: 1; }
    .lp-field-status { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 11px; border-radius: 999px; }
    .lp-field-status.is-live { background: rgba(120,180,140,0.22); color: #A7D8B8; }
    .lp-field-status.is-soon { background: rgba(245,246,248,0.10); color: rgba(245,246,248,0.72); }
    .lp-field-name { font-family: var(--display); font-size: 22px; font-weight: 700; letter-spacing: -0.015em; color: #F5F6F8; margin: 14px 0 0; }
    .lp-field-visual { position: relative; z-index: 1; margin-top: auto; padding-top: 24px; height: 92px; display: flex; align-items: center; justify-content: center; }
    .lp-field-visual svg { width: 58px; height: 58px; }

    /* „Alle ansehen"-Link zur Fachrichtungs-Seite */
    .lp-viewall {
      display: inline-flex; align-items: center; gap: 10px; margin-top: clamp(8px, 1.5vw, 18px);
      font-size: 15px; font-weight: 600; color: var(--navy); text-decoration: none;
      border: 1px solid var(--line); border-radius: 999px; padding: 12px 12px 12px 22px;
      transition: border-color .2s ease, transform .2s ease, background .2s ease;
    }
    .lp-viewall span { width: 30px; height: 30px; border-radius: 50%; background: var(--navy); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; transition: transform .3s cubic-bezier(0.16,1,0.3,1); }
    .lp-viewall:hover { border-color: rgba(27,42,74,0.4); transform: translateY(-2px); }
    .lp-viewall:hover span { transform: rotate(45deg); }
    .lp-viewall:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

    @media (max-width: 980px) { .lp-fields-head { align-items: flex-start; } }
    @media (prefers-reduced-motion: reduce) {
      .lp-marquee { overflow-x: auto; }
      .lp-marquee-track { animation: none; padding-left: 0; }
    }

    /* ── SECTION 3 · Für wen (B2B & B2C) · Scroll-Cross-Fade ── */
    .lp-offers-sec { background: var(--bg); color: var(--ink); }
    /* Standard (ohne JS / reduced-motion): statisch, Text über den Cards */
    .lp-offers-stage { padding: clamp(72px, 9vw, 120px) 0; }
    .lp-offers-head { text-align: center; max-width: 700px; margin: 0 auto clamp(40px, 5vw, 64px); }
    .lp-offers { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    /* Gepinnt (JS aktiviert): Text mittig; beim Scrollen Cross-Fade zu den Cards */
    .lp-offers-scroll.is-pinned { position: relative; height: 200vh; }
    .lp-offers-scroll.is-pinned .lp-offers-stage {
      position: sticky; top: 0; min-height: 100vh; padding: 0;
      display: grid; grid-template-areas: 'stack'; place-items: center; overflow: hidden;
    }
    .lp-offers-scroll.is-pinned .lp-offers-head { grid-area: stack; margin: 0 auto; will-change: opacity, transform; }
    .lp-offers-scroll.is-pinned .lp-offers-cardswrap { grid-area: stack; width: 100%; will-change: opacity, transform; }
    /* Cards im Navy-Gold-Schema (analog zu Section 1/2) */
    .lp-offer {
      display: flex; flex-direction: column; position: relative; overflow: hidden;
      background: radial-gradient(140% 130% at 20% 8%, #33569E 0%, #1B2A4A 58%);
      border: 1px solid rgba(255,255,255,0.10); border-radius: 26px;
      padding: clamp(30px, 3vw, 46px);
      box-shadow: 0 22px 48px -32px rgba(12,20,36,0.7);
      transition: transform .35s cubic-bezier(0.16,1,0.3,1), box-shadow .35s ease, border-color .35s ease;
    }
    .lp-offer::after { content: ''; position: absolute; width: 240px; height: 240px; right: -80px; bottom: -100px; background: radial-gradient(circle, rgba(196,168,130,0.28), rgba(196,168,130,0) 70%); pointer-events: none; }
    .lp-offer > * { position: relative; z-index: 1; }
    .lp-offer:hover { transform: translateY(-5px); border-color: rgba(255,255,255,0.24); box-shadow: 0 48px 80px -38px rgba(12,20,36,0.85); }
    .lp-offer-icon {
      width: 56px; height: 56px; border-radius: 16px; margin-bottom: 22px;
      background: rgba(245,246,248,0.08); border: 1px solid rgba(245,246,248,0.14);
      display: flex; align-items: center; justify-content: center;
    }
    .lp-offer-icon svg { width: 30px; height: 30px; }
    .lp-offer-eyebrow { font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold); }
    .lp-offer-title { font-family: var(--display); font-size: clamp(24px, 2.4vw, 30px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.08; color: #F5F6F8; margin: 12px 0 12px; }
    .lp-offer-desc { font-size: 15.5px; line-height: 1.6; color: rgba(245,246,248,0.76); margin: 0 0 24px; }
    .lp-offer-list { list-style: none; margin: 0 0 30px; padding: 0; display: flex; flex-direction: column; gap: 13px; }
    .lp-offer-list li { position: relative; padding-left: 30px; font-size: 15px; line-height: 1.5; color: rgba(245,246,248,0.9); z-index: 1; }
    .lp-offer-list li::before {
      content: '✓'; position: absolute; left: 0; top: 1px; width: 20px; height: 20px; border-radius: 50%;
      background: rgba(196,168,130,0.24); color: var(--gold); font-size: 11px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
    }
    .lp-offer-cta { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 600; color: #F5F6F8; text-decoration: none; }
    .lp-offer-cta span { width: 34px; height: 34px; border-radius: 50%; background: var(--gold); color: var(--navy); display: inline-flex; align-items: center; justify-content: center; font-size: 14px; transition: transform .3s cubic-bezier(0.16,1,0.3,1); }
    .lp-offer-cta:hover span { transform: rotate(45deg); }
    .lp-offer-cta:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 4px; }
    @media (max-width: 820px) { .lp-offers { grid-template-columns: 1fr; } }

    /* ── SECTION 4 · Warum Titan (gestapelte Scroll-Cards, sticky-stack) ── */
    .lp-why-sec { background: var(--bg); color: var(--ink); padding: 0 0 clamp(84px, 10vw, 148px); }
    .lp-why-sec .lp-divider { margin: clamp(58px, 7vw, 92px) 0; }
    /* Deck-Deal: Cards liegen aufeinander (Card 1 oben); beim Scrollen wischt die
       oberste nach oben weg wie beim Kartenverteilen. Layout je Card wie im
       orizon-Screenshot: Headline links, Grafik rechts, darunter zwei Sub-Spalten. */
    .lp-deal-scroll { position: relative; height: 320vh; margin-top: clamp(20px, 3vw, 40px); }
    .lp-deal-stage { position: sticky; top: 0; min-height: 100vh; display: grid; grid-template-areas: 'stack'; place-items: center; }
    .lp-deal-card {
      grid-area: stack; width: min(92vw, 1000px); height: calc(100svh - 44px);
      display: flex; flex-direction: column; justify-content: space-between; gap: clamp(28px, 4vw, 48px);
      background: radial-gradient(120% 130% at 12% 8%, #33569E 0%, #1B2A4A 60%);
      border: 1px solid rgba(255,255,255,0.10); border-radius: 28px; overflow: hidden;
      padding: clamp(30px, 4vw, 64px);
      box-shadow: 0 40px 90px -36px rgba(12,20,36,0.85);
      will-change: transform;
    }
    /* Card 1/2/3 visuell unterschiedlich (Blau → Indigo → Petrol), Gold verbindet */
    .lp-deal-card:nth-child(1) { z-index: 3; background: radial-gradient(120% 130% at 14% 8%, #2E4C8C 0%, #13213E 62%); }
    .lp-deal-card:nth-child(2) { z-index: 2; background: radial-gradient(120% 130% at 14% 8%, #4A3F86 0%, #191536 62%); }
    .lp-deal-card:nth-child(3) { z-index: 1; background: radial-gradient(120% 130% at 14% 8%, #256E79 0%, #0F2930 62%); }
    .lp-deal-top { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 3vw, 48px); align-items: center; }
    .lp-deal-h { font-family: var(--display); font-size: clamp(30px, 4.2vw, 52px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02; color: #F5F6F8; margin: 0; }
    .lp-deal-head .lp-sec-eyebrow { color: var(--gold); margin-bottom: 14px; }
    .lp-deal-lead { font-size: clamp(15px, 1.4vw, 17px); line-height: 1.6; color: rgba(245,246,248,0.72); margin: 16px 0 0; max-width: 42ch; }
    .lp-deal-media { border-radius: 18px; aspect-ratio: 16 / 10; background: rgba(245,246,248,0.05); border: 1px solid rgba(245,246,248,0.10); display: flex; align-items: center; justify-content: center; padding: clamp(18px, 2vw, 28px); }
    .lp-deal-media svg { width: 100%; height: 100%; max-width: 300px; }
    .lp-deal-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 56px); }
    .lp-deal-col h4 { font-family: var(--display); font-size: clamp(18px, 1.9vw, 23px); font-weight: 700; letter-spacing: -0.01em; color: #F5F6F8; margin: 0 0 10px; }
    .lp-deal-col p { font-size: 15px; line-height: 1.6; color: rgba(245,246,248,0.68); margin: 0; }
    .lp-deal-scroll.no-pin { height: auto; }
    .lp-deal-scroll.no-pin .lp-deal-stage { position: static; min-height: 0; display: flex; flex-direction: column; gap: 22px; }
    .lp-deal-scroll.no-pin .lp-deal-card { height: auto; }
    @media (max-width: 760px) {
      .lp-deal-scroll { height: auto; }
      .lp-deal-stage { position: static; min-height: 0; display: flex; flex-direction: column; gap: 22px; }
      .lp-deal-top, .lp-deal-cols { grid-template-columns: 1fr; }
      .lp-deal-card { width: 100%; height: auto; }
      .lp-deal-card:nth-child(n) { z-index: auto; }
    }

    /* ── ENTRANCE ── */
    .lp[data-anim-ready] [data-anim] { opacity: 0; transform: translateY(20px); }
    .lp[data-anim-ready] [data-drop] { opacity: 0; }

    /* ── RESPONSIVE ── */
    @media (max-width: 820px) {
      .lp-nav-inner, .lp-hero-content { padding-left: 22px; padding-right: 22px; }
      .lp-hero-content { padding-top: 110px; padding-bottom: 108px; }
      .lp-hero-text { padding: 42px 24px 30px; border-radius: 22px; }
      .lp-eyebrow { left: 22px; }
      .lp-hero-actions { right: 22px; left: 22px; bottom: 24px; justify-content: flex-start; }
      .lp-bg { width: 210vw; transform: translateY(66%); }
      .lp-scrim { background: linear-gradient(0deg, rgba(5,6,12,0.4) 0%, rgba(5,6,12,0) 40%), linear-gradient(90deg, rgba(5,6,12,0.6) 0%, rgba(5,6,12,0.1) 100%); }
    }
    @media (hover: none), (pointer: coarse) {
      .lp-cursor { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lp-cta, .lp-cta-circle, .lp-burger span, .lp-cursor { transition: none; }
      .lp-dot { animation: none; }
      .lp-cursor { display: none; }
    }
  </style>

  <script>
    import { gsap } from 'gsap';

    function initLanding(): void {
      const lp = document.querySelector<HTMLElement>('.lp');
      if (!lp || lp.dataset.wired === 'true') return;
      lp.dataset.wired = 'true';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fine = window.matchMedia('(pointer:fine)').matches;
      const anim = Array.from(document.querySelectorAll<HTMLElement>('[data-anim]'));

      /* Entrance */
      if (reduce) {
        anim.forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; });
      } else {
        lp.setAttribute('data-anim-ready', '');
        gsap.to(anim, {
          opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.1, delay: 0.1,
          onComplete: () => anim.forEach((el) => { el.style.transform = ''; }),
        });
      }

      /* Badge fällt zeitversetzt von oben, taucht zur Hälfte in die Karte ein
         und drückt dabei die Oberkante nach unten (Kerbe öffnet sich) — die
         gedrückte Kante bleibt stehen: 2,5-px-Naht rund um die Badge-Hälfte. */
      const drop = document.querySelector<HTMLElement>('[data-drop]');
      const cardBg = document.querySelector<HTMLElement>('.lp-card-bg');
      if (drop && cardBg) {
        const GAP = 2.5;
        // Kerbenbreite/-position aus der gemessenen Badge-Geometrie ableiten.
        const measureNotch = (): number => {
          const cr = cardBg.getBoundingClientRect();
          const br = drop.getBoundingClientRect();
          cardBg.style.setProperty('--nx', `${br.left - cr.left - GAP}px`);
          cardBg.style.setProperty('--nw', `${br.width + GAP * 2}px`);
          return br.height / 2 + GAP; // Tiefe = eingetauchte Hälfte + Naht
        };
        const nh = measureNotch();

        if (reduce) {
          cardBg.style.setProperty('--nh', `${nh}px`);
          drop.style.opacity = '1';
        } else {
          const tl = gsap.timeline({ delay: 0.7 });
          tl.fromTo(drop,
            { opacity: 0, y: -80, yPercent: -50 },
            { opacity: 1, y: 0, yPercent: -50, duration: 0.9, ease: 'power3.out' });
          // Kerbe öffnet sich sanft im letzten Teil des Falls (Kante gedrückt).
          tl.fromTo(cardBg,
            { '--nh': '0px' },
            { '--nh': `${nh}px`, duration: 0.6, ease: 'power2.out' }, '-=0.42');
        }
        // Bei Größenänderung Kerbe neu vermessen (statisch nachziehen).
        window.addEventListener('resize', () => {
          const f = measureNotch();
          cardBg.style.setProperty('--nh', `${f}px`);
        });
      }

      /* Parallax des Erd-Wraps (ruhige Tiefe) */
      const hero = document.querySelector<HTMLElement>('.lp-hero');
      const wrap = document.querySelector<HTMLElement>('.lp-bg-wrap');
      if (hero && wrap && fine && !reduce) {
        hero.addEventListener('mousemove', (e) => {
          const r = hero.getBoundingClientRect();
          const dx = (e.clientX - r.left) / r.width - 0.5;
          const dy = (e.clientY - r.top) / r.height - 0.5;
          gsap.to(wrap, { x: dx * -34, y: dy * -20, duration: 1.2, ease: 'power2.out' });
        });
        hero.addEventListener('mouseleave', () => gsap.to(wrap, { x: 0, y: 0, duration: 1.4, ease: 'power2.out' }));
      }

      /* Burger-Menü — kreisförmiges Aufblähen vom Button aus (barrierefrei) */
      const burger = document.querySelector<HTMLButtonElement>('.lp-burger');
      const menu = document.querySelector<HTMLElement>('#lp-menu');
      if (burger && menu) {
        const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
        const radius = (cx: number, cy: number): number =>
          Math.hypot(Math.max(cx, window.innerWidth - cx), Math.max(cy, window.innerHeight - cy));

        const openMenu = () => {
          const b = burger.getBoundingClientRect();
          const cx = b.left + b.width / 2, cy = b.top + b.height / 2;
          menu.style.setProperty('--cx', `${cx}px`);
          menu.style.setProperty('--cy', `${cy}px`);
          menu.hidden = false;
          burger.setAttribute('aria-expanded', 'true');
          burger.setAttribute('aria-label', 'Menü schließen');
          const r = radius(cx, cy) + 40;
          if (reduce) {
            menu.style.setProperty('--r', `${r}px`);
          } else {
            gsap.fromTo(menu, { '--r': '0px' }, { '--r': `${r}px`, duration: 0.7, ease: 'power3.inOut' });
            gsap.fromTo(links, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.08, delay: 0.28 });
          }
          links[0]?.focus();
        };
        const closeMenu = (focusBurger = true) => {
          burger.setAttribute('aria-expanded', 'false');
          burger.setAttribute('aria-label', 'Menü öffnen');
          if (focusBurger) burger.focus();
          if (reduce) { menu.hidden = true; menu.style.setProperty('--r', '0px'); return; }
          gsap.to(menu, { '--r': '0px', duration: 0.5, ease: 'power3.inOut', onComplete: () => { menu.hidden = true; } });
        };
        burger.addEventListener('click', () => (menu.hidden ? openMenu() : closeMenu()));
        links.forEach((a) => a.addEventListener('click', () => closeMenu(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) closeMenu(); });
        menu.addEventListener('click', (e) => { if (e.target === menu) closeMenu(); });
      }

      /* orizon-artiger Cursor */
      const cursor = document.querySelector<HTMLElement>('.lp-cursor');
      if (cursor && fine && !reduce) {
        const xTo = gsap.quickTo(cursor, 'x', { duration: 0.4, ease: 'power3' });
        const yTo = gsap.quickTo(cursor, 'y', { duration: 0.4, ease: 'power3' });
        gsap.set(cursor, { xPercent: -50, yPercent: -50 });
        window.addEventListener('mousemove', (e) => {
          cursor.classList.add('is-active');
          xTo(e.clientX); yTo(e.clientY);
        });
        window.addEventListener('mouseout', (e) => { if (!e.relatedTarget) cursor.classList.remove('is-active'); });
        document.addEventListener('mouseover', (e) => {
          const t = (e.target as HTMLElement).closest('a, button');
          cursor.classList.toggle('is-hover', !!t);
        });
      }

      /* Scroll-Reveals (ruhig, gestaffelt je Gruppe) */
      const reveals = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (reveals.length) {
        if (reduce) {
          reveals.forEach((el) => { el.style.opacity = '1'; });
        } else {
          gsap.set(reveals, { opacity: 0, y: 28 });
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const el = e.target as HTMLElement;
              gsap.to(el, { opacity: 1, y: 0, duration: 0.75, ease: 'power3.out', delay: (Number(el.dataset.i) || 0) * 0.09, onComplete: () => { el.style.transform = ''; } });
              io.unobserve(el);
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
          reveals.forEach((el) => {
            const parent = el.parentElement;
            const idx = parent ? Array.prototype.indexOf.call(parent.children, el) : 0;
            el.dataset.i = String(Math.min(idx, 7)); // Stagger je Gruppe (max 7)
            io.observe(el);
          });
        }
      }

      /* Fachrichtungen-Karussell: Karten für nahtlosen Endlos-Loop duplizieren */
      const track = document.querySelector<HTMLElement>('[data-marquee]');
      if (track && track.dataset.looped !== 'true') {
        track.dataset.looped = 'true';
        track.querySelectorAll('.lp-field').forEach((card) => {
          const clone = card.cloneNode(true) as HTMLElement;
          clone.setAttribute('aria-hidden', 'true');
          track.appendChild(clone);
        });
      }

      /* Section 3: Text mittig → beim Scrollen Cross-Fade zu den Cards */
      const oScroll = document.querySelector<HTMLElement>('.lp-offers-scroll');
      const oHead = document.querySelector<HTMLElement>('[data-offers-head]');
      const oCards = document.querySelector<HTMLElement>('[data-offers-cards]');
      if (oScroll && oHead && oCards && !reduce) {
        oScroll.classList.add('is-pinned');
        const smooth = (a: number, b: number, x: number): number => {
          const t = Math.min(Math.max((x - a) / (b - a), 0), 1);
          return t * t * (3 - 2 * t);
        };
        let ticking = false;
        const render = (): void => {
          ticking = false;
          const total = Math.max(oScroll.offsetHeight - window.innerHeight, 1);
          const scrolled = Math.min(Math.max(-oScroll.getBoundingClientRect().top, 0), total);
          const p = scrolled / total;
          const headOp = 1 - smooth(0.12, 0.46, p);
          const cardOp = smooth(0.42, 0.74, p);
          oHead.style.opacity = String(headOp);
          oHead.style.transform = `translateY(${-28 * (1 - headOp)}px)`;
          oHead.style.pointerEvents = headOp > 0.5 ? 'auto' : 'none';
          oCards.style.opacity = String(cardOp);
          oCards.style.transform = `translateY(${44 * (1 - cardOp)}px)`;
          oCards.style.pointerEvents = cardOp > 0.5 ? 'auto' : 'none';
        };
        const onScroll = (): void => { if (!ticking) { ticking = true; requestAnimationFrame(render); } };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        render();
      }

      /* Section 4: „Karten austeilen" — oberste Card wischt beim Scrollen nach oben weg */
      const dealScroll = document.querySelector<HTMLElement>('.lp-deal-scroll');
      const dealCards = Array.from(document.querySelectorAll<HTMLElement>('.lp-deal-card'));
      if (dealScroll && dealCards.length) {
        if (reduce) {
          dealScroll.classList.add('no-pin');
        } else {
          const n = dealCards.length;
          let dticking = false;
          const renderDeal = (): void => {
            dticking = false;
            const total = Math.max(dealScroll.offsetHeight - window.innerHeight, 1);
            const scrolled = Math.min(Math.max(-dealScroll.getBoundingClientRect().top, 0), total);
            const p = scrolled / total;
            dealCards.forEach((card, i) => {
              if (i === n - 1) { card.style.transform = ''; card.style.opacity = '1'; return; }
              let local = (p - i / n) / (1 / n);
              local = Math.min(Math.max(local, 0), 1);
              const gone = window.innerHeight / 2 + card.offsetHeight / 2 + 60;
              card.style.transform = `translate(${local * 46}px, ${-local * gone}px) rotate(${-local * 7}deg)`;
              card.style.opacity = String(1 - local * 0.12);
            });
          };
          const onDeal = (): void => { if (!dticking) { dticking = true; requestAnimationFrame(renderDeal); } };
          window.addEventListener('scroll', onDeal, { passive: true });
          window.addEventListener('resize', onDeal);
          renderDeal();
        }
      }
    }

    document.addEventListener('astro:page-load', initLanding);
  </script>
</BaseLayout>
